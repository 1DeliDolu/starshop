{% extends 'base.html.twig' %}

{% block title %}Mailer Testing{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Symfony Mailer Testing</h1>
    
    <div class="bg-blue-100 border border-blue-300 rounded p-4 mb-6">
        <h2 class="text-xl font-semibold mb-4">Universal Travel - Email System</h2>
        <p class="mb-4">Welcome to our galactic travel email testing system!</p>
        
        <a href="{{ path('app_mail_test') }}" 
           class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
            Send Test Email
        </a>
    </div>
    
    <div class="bg-gray-100 p-4 rounded">
        <h3 class="font-semibold mb-2">Current Mailer Configuration:</h3>
        <p class="text-sm text-gray-600">
            MAILER_DSN: <code class="bg-gray-200 px-1 rounded">null://null</code> (Development mode)
        </p>
        <p class="text-sm text-gray-600 mt-2">
            Emails are not actually sent in this configuration - perfect for testing!
        </p>
    </div>
</div>
{% endblock %}
