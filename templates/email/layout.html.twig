{% apply inky_to_html %}
    <style>
        /* Foundation for Emails Core Styles */
        .wrapper { width: 100%; }
        body {
            width: 100% !important;
            min-width: 100%;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
            margin: 0;
            padding: 0;
            -moz-box-sizing: border-box;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
            color: #0a0a0a;
            font-family: Helvetica, Arial, sans-serif;
            font-weight: normal;
            text-align: left;
            line-height: 1.3;
        }
        
        table.body {
            background: #f3f3f3;
            height: 100%;
            width: 100%;
        }
        
        table.container {
            background: #fefefe;
            width: 580px;
            margin: 0 auto;
            text-align: inherit;
        }
        
        .float-center {
            margin: 0 auto;
            float: none;
            text-align: center;
        }
        
        /* Custom Email Styles */
        .trip-name {
            font-size: 32px;
        }
        
        .accent-title {
            color: #666666;
        }
        
        .trip-image {
            border-radius: 12px;
        }
        
        p {
            margin: 0 0 10px 0;
            font-size: 16px;
            line-height: 1.3;
        }
        
        h1, h2, h3, h4, h5, h6 {
            color: inherit;
            word-wrap: normal;
            font-family: Helvetica, Arial, sans-serif;
            font-weight: normal;
            margin-bottom: 10px;
        }
        
        img {
            outline: none;
            text-decoration: none;
            max-width: 100%;
            clear: both;
            display: block;
        }
    </style>
    <container>
        {% block content %}{% endblock %}
        <row>
            <columns>
                <p>We can't wait to see you there,</p>
                <p>Your friends at Universal Travel</p>
            </columns>
        </row>
    </container>
{% endapply %}
