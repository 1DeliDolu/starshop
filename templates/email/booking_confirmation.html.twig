{% extends 'email/layout.html.twig' %}

{% block content %}
        <p class="accent-title">Get Ready for your trip to</p>
        <h1 class="trip-name">{{ trip.name }}</h1>
        <img class="trip-image" 
             src="{{ email.image('@images/%s.png'|format(trip.slug)) }}" 
             alt="{{ trip.name }}">
        
        <p class="departure accent-title">Departure: {{ booking.date|date('Y-m-d') }}</p>
        
        <div class="text-center">
            <a href="{{ url('booking_show', {uid: booking.uid}) }}" class="button">
                Manage Booking
            </a>
            <a href="{{ url('bookings', {uid: customer.uid}) }}" class="button secondary">
                My Account
            </a>
        </div>
{% endblock %}