<!DOCTYPE html>
<html>
<head>
    <title>Test Email</title>
</head>
<body>
    <h1>Test Email with Tags and Metadata</h1>
    
    <p>Hello! This is a test email sent with:</p>
    <ul>
        <li><strong>Tag:</strong> test</li>
        <li><strong>Metadata:</strong> test_type = command</li>
        <li><strong>Metadata:</strong> timestamp = {{ "now"|date("Y-m-d H:i:s") }}</li>
    </ul>
    
    <p>Trip: {{ trip.name ?? 'Test Trip' }}</p>
    <p>Customer: {{ customer.name ?? 'Test Customer' }}</p>
    <p>Booking ID: {{ booking.uid ?? 'test-booking-123' }}</p>
    
    <h2>URL Test:</h2>
    <p>Home URL: <a href="{{ url('home') }}">{{ url('home') }}</a></p>
    <p>Absolute URL with domain: <a href="{{ absolute_url(path('home')) }}">{{ absolute_url(path('home')) }}</a></p>
</body>
</html>
